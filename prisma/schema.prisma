generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum AuthChallengeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

enum LoginType {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  COD
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(320)
  passwordHash       String?              @db.VarChar(255)
  role               UserRole             @default(CUSTOMER)
  firstName          String               @db.VarChar(100)
  lastName           String               @db.VarChar(100)
  phone              String?              @db.VarChar(30)
  isActive           Boolean              @default(true)
  isEmailVerified    Boolean              @default(false)
  deletedAt          DateTime?            @db.Timestamptz(3)
  addresses          Address[]
  orders             Order[]
  carts              Cart[]
  wishlistItems      WishlistItem[]
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusActor")
  refreshTokens      RefreshToken[]
  authSessions       AuthSession[]
  authChallenges     AuthChallenge[]
  loginHistory       LoginHistory[]
  adminActions       AdminActivityLog[]   @relation("AdminActor")
  adminTargets       AdminActivityLog[]   @relation("AdminTarget")
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  @@index([role])
}

model RefreshToken {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  tokenHash         String       @unique @db.VarChar(255)
  expiresAt         DateTime     @db.Timestamptz(3)
  revokedAt         DateTime?    @db.Timestamptz(3)
  replacedByTokenId String?      @db.Uuid
  sessionId         String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  userAgent     String?        @db.VarChar(500)
  ipAddress     String?        @db.VarChar(64)
  lastUsedAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  revokeReason  String?        @db.VarChar(80)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
}

model AuthChallenge {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  type       AuthChallengeType
  tokenHash  String            @unique @db.VarChar(64)
  expiresAt  DateTime          @db.Timestamptz(3)
  attempts   Int               @default(0)
  consumedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt, expiresAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]
}

model RolePermission {
  role         UserRole
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
}

model LoginHistory {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  email      String    @db.VarChar(320)
  role       UserRole?
  loginType  LoginType
  successful Boolean
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([loginType, createdAt])
}

model AdminActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  targetUserId String?  @db.Uuid
  action       String   @db.VarChar(100)
  details      Json?
  ipAddress    String?  @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  actor        User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

model AuthRateLimitBucket {
  key     String   @id @db.Char(64)
  hits    Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String?  @db.VarChar(50)
  recipientName String   @db.VarChar(200)
  phone         String   @db.VarChar(30)
  addressLine1  String   @db.VarChar(255)
  addressLine2  String?  @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @db.VarChar(20)
  country       String   @default("IN") @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @unique @db.VarChar(120)
  slug           String     @unique @db.VarChar(140)
  description    String?    @db.Text
  products       Product[]
  parentId       String?    @db.Uuid
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  seoTitle       String?    @db.VarChar(160)
  seoDescription String?    @db.VarChar(320)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  deletedAt      DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(3)
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isActive, name])
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  sku              String           @unique @db.VarChar(80)
  title            String           @map("name") @db.VarChar(200)
  slug             String           @unique @db.VarChar(220)
  description      String?          @db.Text
  shortDescription String?          @db.VarChar(500)
  sellingPrice     Decimal          @map("price") @db.Decimal(12, 2)
  mrp              Decimal?         @db.Decimal(12, 2)
  stock            Int              @default(0)
  gstRate          Decimal?         @db.Decimal(5, 2)
  hsnCode          String?          @db.VarChar(12)
  weightGrams      Decimal?         @db.Decimal(10, 3)
  lengthCm         Decimal?         @db.Decimal(10, 2)
  widthCm          Decimal?         @db.Decimal(10, 2)
  heightCm         Decimal?         @db.Decimal(10, 2)
  specifications   Json?
  tags             String[]         @default([])
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isActive         Boolean          @default(false)
  deletedAt        DateTime?        @db.Timestamptz(3)
  categoryId       String?          @db.Uuid
  brandId          String?          @db.Uuid
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  relatedFrom      RelatedProduct[] @relation("ProductRelationSource")
  relatedTo        RelatedProduct[] @relation("ProductRelationTarget")
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt])
  @@index([isFeatured, isActive])
  @@index([isBestSeller, isActive])
  @@index([deletedAt])
}

model ProductVariant {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @db.Uuid
  sku          String      @unique @db.VarChar(80)
  size         String?     @db.VarChar(80)
  color        String?     @db.VarChar(80)
  sellingPrice Decimal?    @db.Decimal(12, 2)
  mrp          Decimal?    @db.Decimal(12, 2)
  stock        Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([productId, size, color])
  @@index([productId, isActive])
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  storagePath String?  @unique @db.VarChar(255)
  url         String   @db.VarChar(2048)
  altText     String?  @db.VarChar(200)
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int?
  height      Int?
  format      String   @db.VarChar(20)
  bytes       Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model RelatedProduct {
  productId        String   @db.Uuid
  relatedProductId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  product          Product  @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product  @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
}

model Order {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique @db.VarChar(40)
  userId          String               @db.Uuid
  status          OrderStatus          @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus        @default(PENDING)
  subtotal        Decimal              @db.Decimal(12, 2)
  discountTotal   Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal              @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @db.Decimal(12, 2)
  shippingAddress Json
  billingAddress  Json
  returnReason    String?              @db.VarChar(500)
  notes           String?              @db.Text
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @db.Uuid
  productId      String?         @db.Uuid
  productName    String          @db.VarChar(200)
  sku            String          @db.VarChar(80)
  unitPrice      Decimal         @db.Decimal(12, 2)
  unitMrp        Decimal         @default(0) @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  gstRate        Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  variantId      String?         @db.Uuid
  variantLabel   String?         @db.VarChar(200)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  customerId     String?    @unique @db.Uuid
  guestTokenHash String?    @unique @db.VarChar(64)
  guestExpiresAt DateTime?  @db.Timestamptz(3)
  customer       User?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([guestExpiresAt])
}

model CartItem {
  id         String          @id @default(uuid()) @db.Uuid
  cartId     String          @db.Uuid
  productId  String          @db.Uuid
  variantId  String?         @db.Uuid
  variantKey String          @db.VarChar(40)
  quantity   Int
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, productId])
  @@index([productId])
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?      @db.Uuid
  comment         String?      @db.VarChar(500)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?        @relation("OrderStatusActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}
