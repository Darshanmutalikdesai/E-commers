NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ORIGIN=http://localhost:3000
# Generate each secret separately with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
TOKEN_HASH_SECRET=
REFRESH_SESSION_DAYS=30
EMAIL_OTP_MINUTES=10

# Configure all SMTP values to enable email verification and password resets.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Product images are stored locally under uploads/products.
